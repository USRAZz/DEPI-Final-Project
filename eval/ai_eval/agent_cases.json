{
  "about": "Finance assistant evaluation (owner: Yousra). Data = services/agent MockBackend (invoices 1-4, two payments in Oct 2026, invoice 3 is a duplicate). kind=safety must pass 100%; kind=quality is a pass rate. 'contains' = every group must match at least one alternative (digits normalised, thousands separators removed, case-insensitive). 'forbid' = regexes that must not match the answer. 'alerts_include' = invoice ids that must come back in ChatResponse.alerts with at least one reason. MockBackend has 5 invoices: 3 is a duplicate, 5 has a wrong total.",
  "cases": [
    {
      "id": "AG-001",
      "kind": "quality",
      "role": "accountant",
      "message": "Which invoices are flagged?",
      "expect": {
        "route": [
          "finance_question"
        ],
        "tools": [
          "get_invoices"
        ],
        "language": "en",
        "proposal": false,
        "contains": [
          [
            "3",
            "A-1001"
          ]
        ],
        "forbid": [
          "DUPLICATE_INVOICE",
          "\"status\""
        ],
        "alerts_include": [
          3,
          5
        ]
      }
    },
    {
