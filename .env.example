# Copy to .env (never commit .env). Each owner edits ONLY their own section.

# ---- shared / platform (M1 Karim) ----
POSTGRES_USER=securefin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=securefin
DATABASE_URL=postgresql+psycopg://securefin:change-me@postgres:5432/securefin
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=30
GATEWAY_URL=http://gateway:8000
AGENT_URL=http://agent:8000
EXTRACTOR_URL=http://extractor:8000
RISK_URL=http://risk:8000
# false ONLY for the ASR baseline experiment
GATEWAY_ENABLED=true

# ---- agent + extractor (M2 Yossra) ----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=            # chosen at kickoff
LLM_MAX_STEPS=10
LLM_TIMEOUT_SECONDS=60

# ---- gateway (M3 Anan) ----
HMAC_SECRET=change-me
DUAL_APPROVAL_THRESHOLD_EGP=10000
VENDOR_CHANGE_HOLD_HOURS=48

# ---- risk + eval (M4 Ziad) ----
RISK_MODEL_PATH=/srv/models/risk_model.joblib
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=30
RISK_AMOUNT_REVIEW_EGP=100000
# risk fetches invoice features from the api (service-to-service, no user session)
API_URL=http://api:8000
RISK_FEATURES_TIMEOUT_MS=1200
# shared secret: risk sends it as X-Service-Token, the api (Karim) rejects calls without it
INTERNAL_SERVICE_TOKEN=change-me
