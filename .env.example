# Copy to .env (never commit .env). Each owner edits ONLY their own section.

# ---- shared / platform (M1 Karim) ----
POSTGRES_USER=securefin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=securefin
DATABASE_URL=postgresql+psycopg://securefin:change-me@postgres:5432/securefin
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=30
GATEWAY_URL=http://gateway:8000
AGENT_URL=http://agent:8000
EXTRACTOR_URL=http://extractor:8000
RISK_URL=http://risk:8000
# false ONLY for the ASR baseline experiment
GATEWAY_ENABLED=true

# ---- agent + extractor (M2 Yossra) ----
# Free tiers only (decision 28/11): OpenRouter first, then Groq, then OpenAI (see LLM_FALLBACK_PROVIDERS below).
# Bank and personal data are masked before every call, whichever provider answers.
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_MODEL=            # chosen at kickoff; per role: ROUTER_MODEL / EXTRACTOR_MODEL / CATEGORIZER_MODEL / AGENT_MODEL
LLM_TIMEOUT_SECONDS=60
LLM_MAX_STEPS=10
LLM_MAX_TOKENS=2000
# leave empty to use the model default
LLM_TEMPERATURE=0

# where the agent's read-only tools get data: mock = sample data in services/agent; api = services/api
# (GET /invoices, /transactions, /invoices/{id}/risk with the user's own identity, at API_URL below)
BACKEND=api
# only the api may call the agent (it trusts X-User-Id): the api sends this, the agent refuses calls without it
AGENT_SERVICE_TOKEN=change-me-agent
AGENT_TIMEOUT_S=180
AGENT_MAX_TOKENS=25000
AGENT_MAX_SECONDS=90
# All free tiers, renewing every day. When one answers 429 (free quota used up) or 402 the next one answers, and it
# is used again by itself once its quota renews (the time the provider announces, else QUOTA_RETRY_SECONDS).
# Entries: "provider" (its <PROVIDER>_MODEL) or "provider:model". Groq limits are per model, so three Groq models
# give three daily quotas. Approved providers: openrouter, groq, openai. Check: python -m ai_core.llm_check (--call)
LLM_FALLBACK_PROVIDERS=openrouter,groq,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openai
QUOTA_RETRY_SECONDS=900
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Model choice per request with OpenRouter's Jev Router (optional; leave LLM_ROUTING empty on a free OpenRouter key:
# Jev may pick a paid model, which a key without credit cannot use) (typesafe/jev-router): it reads each request and picks the
# cheapest model in its pool that is good enough. Needs LLM_PROVIDER=openrouter's key (OPENROUTER_API_KEY).
#   LLM_ROUTING=jev          all roles;  <ROLE>_ROUTING=jev for one role;  a <ROLE>_MODEL always wins over Jev
#   JEV_COST_TIER / <ROLE>_JEV_COST_TIER = low | medium | high (defaults per role in ai_core/llm.py JEV_TIERS)
#   JEV_MODELS = preferred pool, comma-separated (e.g. openai/*,google/*); JEV_EXCLUDED_MODELS = never used
#   JEV_FALLBACK_MODEL = used once if the router is down (404/503); default OPENROUTER_MODEL
# roles: ROUTER EXTRACTOR CATEGORIZER AGENT EXPLAINER REPORT_ORCHESTRATOR REPORT_WORKER REPORT_WRITER REPORT_EVALUATOR
LLM_ROUTING=
JEV_MODELS=
JEV_EXCLUDED_MODELS=
JEV_FALLBACK_MODEL=
# after Jev answers 404/503, calls go straight to the fallback for this long (seconds). Check: python -m ai_core.jev_check
JEV_RETRY_SECONDS=300
# true = use the OS certificate store (pip install truststore). Needed when an antivirus or company proxy inspects HTTPS
# and Python fails with CERTIFICATE_VERIFY_FAILED. Not needed in Docker or CI.
USE_SYSTEM_CERTS=
# reports (pattern ④): one budget for the whole report
REPORT_MAX_TOKENS=40000
REPORT_MAX_SECONDS=150
# /v1/explain: false = fixed wording only (no LLM call); the model's wording is used only when it matches the codes.
# Model per role as above: EXPLAINER_MODEL (else the provider's model)
EXPLAIN_USE_LLM=true
INVOICE_MAX_TOKENS=12000
INVOICE_MAX_SECONDS=90
# paddleocr (default, best on Arabic) | tesseract | vision (sends unmasked images: needs OCR_VISION_ALLOW_UNMASKED=true)
OCR_ENGINE=paddleocr
# Optional second reading of Arabic item tables with QARI-OCR (eval/OCR_BENCHMARK.md). Off when empty.
# "qari" needs torch + transformers (not in the extractor requirements) and a GPU; downloads ~4.5 GB once.
OCR_ARABIC_REREAD=
OCR_QARI_MODEL=NAMAA-Space/Qari-OCR-v0.3-VL-2B-Instruct
# Windows path to tesseract.exe (only for OCR_ENGINE=tesseract)
TESSERACT_CMD=

# ---- gateway (M3 Anan) ----
HMAC_SECRET=change-me
DUAL_APPROVAL_THRESHOLD_EGP=10000
VENDOR_CHANGE_HOLD_HOURS=48

# ---- risk + eval (M4 Ziad) ----
RISK_MODEL_PATH=/srv/models/risk_model.joblib
RISK_HIGH_THRESHOLD=70
RISK_MEDIUM_THRESHOLD=30
RISK_AMOUNT_REVIEW_EGP=100000
# risk fetches invoice features from the api (service-to-service, no user session)
API_URL=http://api:8000
RISK_FEATURES_TIMEOUT_MS=1200
# shared secret: risk and gateway send it as X-Service-Token when they read from the api (risk features,
# GET /payments/{id}); the api (Karim) rejects calls without it
INTERNAL_SERVICE_TOKEN=change-me
# only the api may ask the gateway for decisions (authorize, approvals, execute-check): the api sends it as
# X-Service-Token, the gateway answers 401 without it and 503 when it is not set. Use a different value from
# INTERNAL_SERVICE_TOKEN and AUDIT_VERIFY_TOKEN (openssl rand -hex 32).
GATEWAY_SERVICE_TOKEN=change-me-too
# ---- n8n automations (M4 Ziad; see n8n/README.md) ----
# Required to start n8n. Generate once (openssl rand -hex 32) and never change it: it decrypts saved credentials.
N8N_ENCRYPTION_KEY=
# The three URLs below are EMPTY on purpose: each workflow then runs standalone (n8n/README.md).
# Fill one in to connect that workflow to the real service.
# 1 intake: when connected use http://api:8000/v1/invoices/upload and a token the api accepts ONLY there (Karim)
N8N_INVOICE_UPLOAD_URL=
N8N_INTAKE_TOKEN=change-me
N8N_COMPANY_ID=1
# 2 notifications: the gateway signs events with this (32+ chars). NOT the approval signing key.
N8N_WEBHOOK_HMAC_SECRET=
N8N_DECISION_WEBHOOK_URL=http://n8n:5678/webhook/securefin/decision-events
APP_BASE_URL=http://localhost:3000
TELEGRAM_CHAT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# 3 integrity run: when connected use http://gateway:8000/v1/audit/verify; the gateway accepts the token ONLY there
N8N_AUDIT_VERIFY_URL=
AUDIT_VERIFY_TOKEN=change-me
N8N_AUDIT_COMPANY_IDS=1
# empty = attack suite not run (the report says "NOT checked"); set when the eval runner exists
N8N_ATTACK_RUN_URL=
N8N_EVAL_TOKEN=
N8N_ATTACK_MIN_CASES=22
# optional outside "dead man's switch" (for example a healthchecks.io ping URL)
N8N_HEARTBEAT_URL=
