{
  "id": "sfInvoiceIntake001",
  "name": "1 Invoice email intake",
  "nodes": [
    {
      "parameters": {
        "mailbox": "INBOX",
        "postProcessAction": "read",
        "downloadAttachments": true,
        "dataPropertyAttachmentsPrefixName": "attachment_",
        "options": {
          "customEmailConfig": "[\"UNSEEN\"]"
        }
      },
      "id": "a1",
      "name": "New invoice email",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "credentials": {
        "imap": {
          "id": "sfInvoiceInbox0001",
          "name": "Invoice inbox (IMAP)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One item per invoice attachment. The type comes from the MIME type the mail client declared; the API\n// checks the real file bytes and enforces the size limit (413), so there is one limit, in one place.\nconst EXT = { 'application/pdf': 'pdf', 'image/png': 'png', 'image/jpeg': 'jpg', 'image/webp': 'webp', 'image/tiff': 'tif' };\nconst MAX_PER_EMAIL = 5;\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const from = typeof j.from === 'string' ? j.from : (j.from?.value?.[0]?.address ?? '');\n  const sender = (from.match(/[^\\s<>\"]+@[^\\s<>\"]+/) ?? [''])[0].toLowerCase();\n  // Message-ID is chosen by the sender, so it is only ever used hashed (see \"Idempotency key\").\n  const messageId = String(j.messageId ?? j.metadata?.['message-id'] ?? `uid-${j.attributes?.uid ?? ''}`);\n  let kept = 0;\n  for (const bin of Object.values(item.binary ?? {})) {\n    const ext = EXT[(bin.mimeType ?? '').toLowerCase()];\n    if (!ext || kept >= MAX_PER_EMAIL) continue;\n    kept += 1;\n    out.push({ json: { sender, message_id: messageId, ext }, binary: { file: bin } });\n  }\n}\nreturn out;"
      },
      "id": "a2",
      "name": "Keep invoice attachments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "binaryData": true,
        "binaryPropertyName": "file",
        "dataPropertyName": "sha256",
        "encoding": "hex"
      },
      "id": "a3",
      "name": "File SHA-256",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "action": "hash",
        "type": "SHA256",
        "value": "={{ $json.message_id + ':' + $json.sha256 }}",
        "dataPropertyName": "idempotency_key",
        "encoding": "hex"
      },
      "id": "a4",
      "name": "Idempotency key",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Arabic file names arrive garbled and are sender-controlled: the file is named after its own hash.\n// The hash nodes pass on JSON only, so the file is taken again from the node that split the attachments.\nconst source = $('Keep invoice attachments').all();\nreturn $input.all().map((item, i) => ({\n  json: item.json,\n  binary: { file: { ...source[i].binary.file, fileName: `${item.json.sha256}.${item.json.ext}` } },\n  pairedItem: i,\n}));"
      },
      "id": "a5",
      "name": "Name file by hash",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_INVOICE_UPLOAD_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Token",
              "value": "={{ $env.N8N_INTAKE_TOKEN }}"
            },
            {
              "name": "X-Company-Id",
              "value": "={{ $env.N8N_COMPANY_ID }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "file"
            },
            {
              "name": "source",
              "value": "email"
            },
            {
              "name": "sender",
              "value": "={{ $json.sender }}"
            },
            {
              "name": "sha256",
              "value": "={{ $json.sha256 }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "a6",
      "name": "Upload to API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// 409 = the API already has this file (UNIQUE source_hash): a duplicate, not a failure.\nconst failed = [];\nfor (const item of $input.all()) {\n  const e = item.json.error ?? {};\n  const status = Number(e.httpCode ?? e.status ?? e.cause?.status ?? e.context?.data?.status ?? 0);\n  const text = String(e.message ?? e.description ?? item.json.error ?? 'no response');\n  if (status === 409 || /\\b409\\b/.test(text)) continue;\n  failed.push(`${item.json.sha256 ?? 'unknown file'}: ${text.slice(0, 160)}`);\n}\nif (!failed.length) return [];\nreturn [{ json: { message: `Invoice intake: ${failed.length} file(s) not uploaded after 3 tries. ` + failed.join(' | ') } }];"
      },
      "id": "a7",
      "name": "Real failures only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        120
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ $json.message }}"
      },
      "id": "a8",
      "name": "Fail the run",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1540,
        120
      ]
    }
  ],
  "connections": {
    "New invoice email": {
      "main": [
        [
          {
            "node": "Keep invoice attachments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Keep invoice attachments": {
      "main": [
        [
          {
            "node": "File SHA-256",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "File SHA-256": {
      "main": [
        [
          {
            "node": "Idempotency key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Idempotency key": {
      "main": [
        [
          {
            "node": "Name file by hash",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Name file by hash": {
      "main": [
        [
          {
            "node": "Upload to API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Upload to API": {
      "main": [
        [],
        [
          {
            "node": "Real failures only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Real failures only": {
      "main": [
        [
          {
            "node": "Fail the run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "sfErrorAlerts0001"
  },
  "active": false
}
