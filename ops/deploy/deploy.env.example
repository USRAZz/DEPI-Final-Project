# Staging / production settings (owner: M4 Ziad). On the server:
#   cp .env.example .env            # every variable the services read
#   then change or add the lines below in .env (later lines win), and run:
#   python ops/deploy/check_env.py staging .env      (or production)
# Never commit the server's .env. Generate each secret separately: openssl rand -hex 32

# ---- which images (built by .github/workflows/images.yml) ----
REGISTRY=ghcr.io/usrazz
# staging: "staging" (newest dev) or "sha-<7 chars>"; production: a release tag, e.g. v0.2.0
IMAGE_TAG=staging

# ---- database ----
# staging may use the compose postgres; production must use the managed database (Neon, direct host).
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://securefin:<POSTGRES_PASSWORD>@postgres:5432/securefin
# read-only login for backups (ops/backup/create_backup_role.sql); required in production
BACKUP_DATABASE_URL=

# ---- secrets: each one different, at least 32 characters ----
APPROVAL_HMAC_KEY=
INTERNAL_SERVICE_TOKEN=
AUDIT_VERIFY_TOKEN=
# production also needs N8N_ENCRYPTION_KEY (never change it once set)
N8N_ENCRYPTION_KEY=

# ---- behaviour that must not be the local default ----
GATEWAY_ENABLED=true
BACKEND=api
DEV_LOGIN=
OPENAI_API_KEY=
